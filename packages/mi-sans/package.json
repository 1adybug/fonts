{
  "name": "@1adybug/mi-sans",
  "version": "0.1.0",
  "description": "Self-host MiSans VF variable font with Unicode-range WOFF2 subsets.",
  "main": "index.css",
  "style": "index.css",
  "types": "index.d.css.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "license": "SEE LICENSE IN LICENSE.pdf",
  "homepage": "https://hyperos.mi.com/font/en/download/",
  "keywords": [
    "font",
    "variable",
    "woff2",
    "css",
    "self-hosted",
    "mi-sans"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "index.css",
    "wght.css",
    "index.d.css.ts",
    "metadata.json",
    "unicode.json",
    "sources.json",
    "README.md",
    "LICENSE",
    "LICENSE.pdf",
    "files/*.woff2"
  ],
  "exports": {
    ".": {
      "types": "./index.d.css.ts",
      "sass": "./index.css",
      "default": "./index.css"
    },
    "./wght": {
      "types": "./index.d.css.ts",
      "sass": "./wght.css",
      "default": "./wght.css"
    },
    "./wght.css": {
      "types": "./index.d.css.ts",
      "sass": "./wght.css",
      "default": "./wght.css"
    },
    "./files/*": "./files/*",
    "./metadata.json": "./metadata.json",
    "./unicode.json": "./unicode.json",
    "./sources.json": "./sources.json",
    "./package.json": "./package.json",
    "./LICENSE": "./LICENSE",
    "./LICENSE.pdf": "./LICENSE.pdf"
  }
}
