{
  "name": "@1adybug/fonts-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "generate": "node scripts/python.mjs scripts/generate.py",
    "check": "node scripts/python.mjs scripts/generate.py --check",
    "test": "node scripts/test.mjs",
    "pack:all": "node scripts/pack.mjs",
    "release": "node scripts/release.mjs",
    "format:check": "prettier --check scripts tests package.json pnpm-workspace.yaml font-config.json"
  },
  "devDependencies": {
    "@fontsource-variable/noto-sans-sc": "5.3.1",
    "playwright": "1.62.1",
    "prettier": "3.9.9",
    "typescript": "6.0.2",
    "vite": "8.3.4"
  }
}
